# Base URL backend FastAPI - TANPA suffix /api/v1.
# Path endpoint di kode sudah memuat /api/v1 (mis. /api/v1/reports),
# jadi jangan tulis http://localhost:8000/api/v1 di sini (akan double prefix).
VITE_API_BASE_URL=http://localhost:8000

# Endpoint instance publik OSRM untuk fitur rute/arah (dipakai sejak FE-15).
# Gunakan domain .org (instance demo resmi; .net tidak resolve di sebagian jaringan).
VITE_OSRM_BASE_URL=https://router.project-osrm.org

# Radius pencarian default slider di halaman daftar ruang publik (kilometer).
VITE_DEFAULT_RADIUS_KM=700

# Ambang validasi lokasi anti fake-GPS (meter) - untuk teks bantuan UI saja.
# Perhitungan sebenarnya ada di backend (FAKE_GPS_THRESHOLD_M, default 100).
VITE_FAKE_GPS_THRESHOLD_M=100
