# Environment produksi (dibaca Vite saat `npm run build` / mode production).

# Base URL backend FastAPI produksi - TANPA suffix /api/v1.
# PLACEHOLDER: ganti dengan URL backend sesungguhnya saat backend sudah di-deploy.
# Contoh: https://api.ruangterbuka.example
VITE_API_BASE_URL=https://api.example.com

# Endpoint instance publik OSRM (sama dengan dev; gunakan domain .org).
VITE_OSRM_BASE_URL=https://router.project-osrm.org

# Radius pencarian default (km) dan ambang validasi lokasi (meter).
VITE_DEFAULT_RADIUS_KM=700
VITE_FAKE_GPS_THRESHOLD_M=100
