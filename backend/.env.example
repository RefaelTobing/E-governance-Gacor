DATABASE_URL=mysql+pymysql://user:password@localhost/raku_db
SECRET_KEY=supersecretkey
FRONTEND_PUBLIC_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174

# Dipakai `python -m app.etl.seed_admin` untuk membuat admin pertama.
# Setelah halaman Kelola Admin ada, hapus ketiga baris ini.
ADMIN_SEED_NAME=Petugas RTH
ADMIN_SEED_EMAIL=petugas@jakarta.go.id
ADMIN_SEED_PASSWORD=ganti-dengan-sandi-anda

# Jadwal pipeline ETL (cron 5 field, WIB) untuk `python -m app.etl.scheduler`.
# Default: tiap hari 02:00. Lihat docs/features/etl-worker.md bagian Penjadwalan.
ETL_JADWAL=0 2 * * *
